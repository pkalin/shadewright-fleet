# Pinned tools for the render check, the scenario harness and the Kind cluster: one place for CI and local runs.
# Sourced by scripts/lib.sh (plain KEY=value lines, no spaces). scripts/install-tools.sh downloads the release
# binaries into bin/ and verifies them against the checksums below, which are the ones each project publishes with
# its release (shellcheck publishes none: computed from the release archives). Dependabot does not see this file,
# so bump a version together with all of its checksums.

# kustomize and kubeconform: scripts/render.sh and the harness render with exactly these versions.
KUSTOMIZE_VERSION=v5.8.1
KUSTOMIZE_SHA256_darwin_amd64=ee7cf0c1e3592aa7bb66ba82b359933a95e7f2e0b36e5f53ed0a4535b017f2f8
